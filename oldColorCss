@import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap');
@import "tailwindcss";

@theme {
    --font-sans: "Inter Tight", "Inter", ui-sans-serif, system-ui, sans-serif;
    --font-display: "Inter Tight", "Inter", ui-sans-serif, system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;

    --color-surface: #ffffff;
    --color-surface-dim: #f1f5f9;
    --color-surface-bright: #ffffff;
    --color-surface-container-lowest: #ffffff;
    --color-surface-container-low: #f8fafc;
    --color-surface-container: #ffffff;
    --color-surface-container-high: #f1f5f9;
    --color-surface-container-highest: #cbd5e1;
    --color-on-surface: #0f172a;
    --color-on-surface-variant: #475569;
    --color-inverse-surface: #0f172a;
    --color-inverse-on-surface: #f8fafc;
    --color-outline: #94a3b8;
    --color-outline-variant: #cbd5e1;
    --color-surface-tint: #3b82f6;
    --color-primary: #E11D48;
    --color-on-primary: #ffffff;
    --color-primary-container: #eff6ff;
    --color-on-primary-container: #1e40af;
    --color-inverse-primary: #E11D48;
    --color-secondary: #F59E0B;
    --color-on-secondary: #ffffff;
    --color-secondary-container: #f5f3ff;
    --color-on-secondary-container: #5b21b6;
    --color-tertiary: #06b6d4;
    --color-on-tertiary: #ffffff;
    --color-tertiary-container: #ecfeff;
    --color-on-tertiary-container: #0e7490;
    --color-error: #ef4444;
    --color-on-error: #ffffff;
    --color-error-container: #fee2e2;
    --color-on-error-container: #991b1b;
    --color-primary-fixed: #dbeafe;
    --color-primary-fixed-dim: #93c5fd;
    --color-on-primary-fixed: #1e3a8a;
    --color-on-primary-fixed-variant: #1e40af;
    --color-secondary-fixed: #ede9fe;
    --color-secondary-fixed-dim: #ddd6fe;
    --color-on-secondary-fixed: #3b0764;
    --color-on-secondary-fixed-variant: #5b21b6;
    --color-tertiary-fixed: #cffafe;
    --color-tertiary-fixed-dim: #67e8f9;
    --color-on-tertiary-fixed: #083344;
    --color-on-tertiary-fixed-variant: #0e7490;
    --color-background: #111317;
    --color-on-background: #0f172a;
    --color-surface-variant: #f1f5f9;

    /* Custom Spacing */
    --spacing-section: 80px;
    --spacing-gutter: 24px;
}

@layer base {
    body {
        @apply bg-background text-on-background selection:bg-primary/20 selection:text-primary font-sans antialiased;
        background-color: #f8fafc;
        /* Clean light background color */
    }

    html {
        scroll-behavior: smooth;
    }
}

@layer components {
    .glass-card {
        @apply bg-white/70 backdrop-blur-xl border border-slate-200/60 shadow-lg shadow-slate-100/50;
    }

    .accent-gradient {
        background: linear-gradient(135deg, #E11D48, #F59E0B 100%);
    }

    .glow-shadow {
        box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.25), 0 8px 10px -6px rgba(124, 58, 237, 0.25);
    }

    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
}

.bg-orb {
    @apply absolute rounded-full blur-[120px] pointer-events-none -z-10;
}